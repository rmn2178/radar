    "seed:generate": "tsx scripts/generate-seed.ts",
    "check:environment": "tsx scripts/check-environment.ts"
  },
  "dependencies": {
    "next": "16.4.6", "react": "19.3.1", "react-dom": "19.3.1",
    "@supabase/ssr": "0.12.7", "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^0.468.0", "motion": "^12.0.0", "zod": "^4.0.0",
    "react-hook-form": "^7.54.0", "@hookform/resolvers": "^5.0.0",
    "@fontsource/manrope": "^5.2.0", "@fontsource/dm-serif-display": "^5.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0", "@types/node": "^24.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "ajv": "^8.17.1",
    "tailwindcss": "^4.0.0", "@tailwindcss/postcss": "^4.0.0",
    "eslint": "^9.0.0", "eslint-config-next": "16.4.6", "tsx": "^4.20.0", "@playwright/test": "^1.56.0"
  }
